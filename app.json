{
  "expo": {
    "name": "We Clean",
    "slug": "MeuProjeto",
    "icon": "./assets/images/icone_app.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.maarantes.MeuProjeto",
      "splash": {
        "resizeMode": "cover",
        "backgroundColor": "#ffffff"
      }
    },
    "splash": {
      "image": "./assets/images/splash_background.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "eb5cb3ab-2442-45c6-a0a4-54b0e3523af8"
      }
    }
  }
}
